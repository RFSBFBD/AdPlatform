# Variable NAMES for the Vercel Docker deployment. Put real values in the Vercel
# project's Environment Variables (Settings), never in a file or in chat.
APP_NAME=AdPlatform
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show   (run locally, paste into Vercel)
APP_KEY=
# the final https URL of the Vercel project
APP_URL=

LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
# Neon connection string. Use the DIRECT (non-pooled) one first.
DB_URL=
DB_SSLMODE=require

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# Exact redirect URI(s) the server may hand to ad platforms, comma-separated. The frontend
# always sends <site origin>/accounts (no trailing slash, no query), so the value is
# https://<your final Vercel domain>/accounts . Empty means EVERY connect attempt is refused.
# The same string must be registered as the redirect URI in each provider's developer app.
# Placeholder only, fill with the real domain after Vercel assigns it.
OAUTH_ALLOWED_REDIRECT_URIS=

# First owner account. With APP_ENV=production the seeder creates NO owner unless
# ADMIN_BOOTSTRAP_PASSWORD is set. Set it only for the one-time seed run, then remove it.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
